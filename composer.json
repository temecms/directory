{
    "name": "temecms/directory",
    "description": "The listings and the tools that build Teme's signed plugin and theme index.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "composer/semver": "^3.4",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Teme\\Directory\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Teme\\Directory\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.3.0" }
    }
}
